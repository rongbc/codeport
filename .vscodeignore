# Sources, tooling and tests are not shipped. `dist/` is not excluded, so the
# built bundle and its tree-sitter WASM assets are packaged as-is.
src/**
test/**
scripts/**
docs/**
.vscode/**
.vscode-test/**
node_modules/**
tsconfig.json
package-lock.json
.gitignore

# The local index is a per-workspace cache. `.gitignore` covers it for git, but
# `vsce` packages according to *this* file, so it must be listed here too or a
# stale index database ships inside the .vsix.
.codeport/**

**/*.vsix
**/*.log
**/*.ts
**/*.map
