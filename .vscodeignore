# Sources, tooling and tests are not shipped.
src/**
test/**
scripts/**
docs/**
.vscode/**
.vscode-test/**
node_modules/**
tsconfig.json
package-lock.json
.gitignore

# The built bundle is the only runtime artifact. Everything else under `dist/` is a
# leftover: the retired local index vendored a tree-sitter WASM runtime into
# `dist/wasm/`, and a build that no longer produces it must not ship a stale copy.
dist/**
!dist/extension.js

# Indexes live in the workspace, never in the package: CodeGraph's `.codegraph/`, and
# the retired CodePort index in `.codeport/`. A stale one must never ship if someone
# builds from inside an indexed folder.
.codegraph/**
.codeport/**

**/*.vsix
**/*.log
**/*.ts
**/*.map
