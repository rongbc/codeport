# Sources, tooling and tests are not shipped. `dist/` is not excluded, so the
# built bundle is packaged as-is. There are no runtime assets any more: CodeGraph
# ships and loads its own parsers.
src/**
test/**
scripts/**
docs/**
.vscode/**
.vscode-test/**
node_modules/**
tsconfig.json
package-lock.json
.gitignore

# CodeGraph keeps its index in the workspace, not in the package, but a stale one
# must never ship if someone builds from inside an indexed folder.
.codegraph/**

**/*.vsix
**/*.log
**/*.ts
**/*.map
