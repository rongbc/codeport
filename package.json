{
  "name": "codeport",
  "displayName": "CodePort \u2014 Navigate Markdown to Source Code",
  "description": "Bring source-code navigation to Markdown. Resolve symbols in code blocks and inline code through a CodeGraph code graph, read in-process with no language server.",
  "version": "0.2.5",
  "publisher": "RongBaichuan",
  "author": "rong baichuan",
  "license": "MIT",
  "icon": "media/codeport_logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rongbc/codeport"
  },
  "homepage": "https://github.com/rongbc/codeport",
  "bugs": {
    "url": "https://github.com/rongbc/codeport/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "markdown",
    "jump",
    "definition",
    "link",
    "symbol",
    "codegraph",
    "navigation",
    "references",
    "hover"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "CodePort reads a CodeGraph index and opens source files. In an untrusted workspace it loads the CodeGraph SDK only from PATH or the user's own installs, never from the workspace's node_modules, because importing that module would run repository code in the extension host."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "CodePort needs a real file system to read a CodeGraph index and open source files."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codeport.goToDefinition",
        "title": "Go to Definition",
        "category": "CodePort"
      },
      {
        "command": "codeport.peekDefinition",
        "title": "Peek Definition",
        "category": "CodePort"
      },
      {
        "command": "codeport.findReferences",
        "title": "Find All References",
        "category": "CodePort"
      },
      {
        "command": "codeport.insertSourceLink",
        "title": "Insert Source Link",
        "category": "CodePort"
      },
      {
        "command": "codeport.rebuildIndex",
        "title": "Show Index Rebuild Command",
        "category": "CodePort"
      },
      {
        "command": "codeport.showIndexStats",
        "title": "Show Index Statistics",
        "category": "CodePort"
      },
      {
        "command": "codeport.showLog",
        "title": "Show Log",
        "category": "CodePort"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeport.goToDefinition",
          "when": "editorLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "codeport.peekDefinition",
          "when": "editorLangId == markdown",
          "group": "navigation@2"
        },
        {
          "command": "codeport.findReferences",
          "when": "editorLangId == markdown",
          "group": "navigation@3"
        },
        {
          "command": "codeport.insertSourceLink",
          "when": "editorLangId == markdown",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "CodePort",
      "properties": {
        "codeport.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Master switch for CodePort.",
          "scope": "window"
        },
        "codeport.definition.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable go-to-definition (F12 / Ctrl+Click) for symbols inside Markdown code blocks and inline code."
        },
        "codeport.references.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Find All References for symbols inside Markdown code blocks and inline code."
        },
        "codeport.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover information (symbol kind, signature, definition site) inside Markdown code blocks and inline code."
        },
        "codeport.codeLink.searchPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra base directories for relative path links (which are always on, and always resolved against the workspace root and the Markdown file's own directory too). Each entry is an absolute path or a path relative to the workspace root; entries are tried in order."
        },
        "codeport.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "messages",
          "description": "Log level for the CodePort output channel.",
          "scope": "window",
          "markdownDescription": "Log level for the CodePort output channel. `off` still reports warnings and errors."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/**/*.test.ts\"",
    "pretest": "node scripts/build.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "package": "npx --yes @vscode/vsce package",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0"
  }
}
